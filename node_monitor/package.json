  "description": "自动监控Markdown文件并与服务端同步",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "setup": "node install.js",
    "startup": "node setup-startup.js",
    "pm2:start": "pm2 start ecosystem.config.js",
